# Copy to .env and fill in. .env is gitignored.
# The reasoning agent is key-optional: with no key it uses the deterministic
# fallback and logs failure_mode="llm_unavailable".

GEMINI_API_KEY=
# GOOGLE_API_KEY also works as an alias
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# /v2/assess feature store (velocity + customer/card profiles). Down -> /v2/assess answers 503.
# REDIS_URL=redis://localhost:6379/0
# REDIS_TIMEOUT_S=0.2

# API keys (Day 16). /assess, /v2/assess and /audit need header X-API-Key. One key per caller (name:key, 16+ chars);
# none set -> those endpoints answer 503. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
RISK_API_KEYS=billing:change-me-billing-key-0001,dashboard:change-me-dashboard-key-01
# the key the Streamlit dashboard sends (the "dashboard:" one above)
RISK_API_KEY=change-me-dashboard-key-01

# Time budget for /v2/assess (ms). Rules + model always run; the LLM explanation only gets what is left.
# RISK_BUDGET_MS=300
# LLM_POOL_SIZE=4            # LLM calls at once; more -> refused (template explanation), never queued
# LLM_HTTP_TIMEOUT_MS=10000  # Gemini HTTP timeout per model tried
# MODEL_THREADS=1            # OpenMP threads for the model (1 is fastest for single payments)
# RULES_PATH=rules.yaml

# Feedback loop (Day 18, docs/adr/0005). Every /v2 decision is kept here; chargebacks become its label.
# FEEDBACK_DB_PATH=data/feedback.db
# FEEDBACK_LABEL_WINDOW_DAYS=120   # "no chargeback" only counts as a label after this
# feedback consumer: chargeback.created + payment.outcome (off by default: the engine runs without Kafka)
# KAFKA_ENABLED=false
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092   # billing's compose: kafka:19092 from another container
# KAFKA_GROUP_ID=risk-engine-feedback
# KAFKA_METADATA_REFRESH_MS=10000          # how soon topics/partitions billing creates later are read (Day 19b)

# Tracing (Day 20a, docs/adr/0007): set an OTLP endpoint to export spans (compose sets http://jaeger:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=risk-engine
